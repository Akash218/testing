# ------------------------------------------------------------------------------
# DC ACTIVE Device
# ------------------------------------------------------------------------------

active_hostname         = "bigip-dc-active.example.com"
active_registration_key = "XXXXX-XXXXX-XXXXX-XXXXX-XXXXXXX"

active_vlans = [
  {
    name = "external"
    tag  = 100
    mtu  = 1500
    interfaces = [
      { name = "1.1", tagged = true }
    ]
  },
  {
    name = "internal"
    tag  = 200
    mtu  = 1500
    interfaces = [
      { name = "1.2", tagged = true }
    ]
  },
  {
    name = "ha"
    tag  = 300
    mtu  = 1500
    interfaces = [
      { name = "1.3", tagged = true }
    ]
  }
]

active_self_ips = [
  {
    name          = "external-self"
    address       = "10.20.1.11/24"
    vlan          = "external"
    traffic_group = "traffic-group-local-only"
    allow_service = "default"
  },
  {
    name          = "internal-self"
    address       = "10.20.2.11/24"
    vlan          = "internal"
    traffic_group = "traffic-group-local-only"
    allow_service = "default"
  },
  {
    name          = "ha-self"
    address       = "10.20.3.11/24"
    vlan          = "ha"
    traffic_group = "traffic-group-local-only"
    allow_service = "default"
  },
  {
    name          = "external-floating"
    address       = "10.20.1.10/24"
    vlan          = "external"
    traffic_group = "traffic-group-1"
    allow_service = "default"
  },
  {
    name          = "internal-floating"
    address       = "10.20.2.10/24"
    vlan          = "internal"
    traffic_group = "traffic-group-1"
    allow_service = "default"
  }
]

active_routes = [
  {
    name    = "default-route"
    network = "default"
    gateway = "10.20.1.1"
  }
]

active_configsync_ip            = "10.20.3.11"
active_failover_unicast_address = "10.20.3.11"
active_mirror_primary_ip        = "10.20.3.11"
active_mirror_secondary_ip      = "10.20.2.11"

# ------------------------------------------------------------------------------
# DC STANDBY Device
# ------------------------------------------------------------------------------

standby_hostname         = "bigip-dc-standby.example.com"
standby_registration_key = "YYYYY-YYYYY-YYYYY-YYYYY-YYYYYYY"

standby_vlans = [
  {
    name = "external"
    tag  = 100
    mtu  = 1500
    interfaces = [
      { name = "1.1", tagged = true }
    ]
  },
  {
    name = "internal"
    tag  = 200
    mtu  = 1500
    interfaces = [
      { name = "1.2", tagged = true }
    ]
  },
  {
    name = "ha"
    tag  = 300
    mtu  = 1500
    interfaces = [
      { name = "1.3", tagged = true }
    ]
  }
]

standby_self_ips = [
  {
    name          = "external-self"
    address       = "10.20.1.12/24"
    vlan          = "external"
    traffic_group = "traffic-group-local-only"
    allow_service = "default"
  },
  {
    name          = "internal-self"
    address       = "10.20.2.12/24"
    vlan          = "internal"
    traffic_group = "traffic-group-local-only"
    allow_service = "default"
  },
  {
    name          = "ha-self"
    address       = "10.20.3.12/24"
    vlan          = "ha"
    traffic_group = "traffic-group-local-only"
    allow_service = "default"
  }
]

standby_routes = [
  {
    name    = "default-route"
    network = "default"
    gateway = "10.20.1.1"
  }
]

standby_configsync_ip            = "10.20.3.12"
standby_failover_unicast_address = "10.20.3.12"
standby_mirror_primary_ip        = "10.20.3.12"
standby_mirror_secondary_ip      = "10.20.2.12"
