# ==============================================================================
# DC Environment — Example terraform.tfvars
#
# Copy this file to terraform.tfvars and fill in your actual values:
#   cp terraform.tfvars.example terraform.tfvars
#
# IMPORTANT: terraform.tfvars contains sensitive data (passwords, license keys).
#            It is excluded from git via .gitignore. NEVER commit this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Connection
# ------------------------------------------------------------------------------

active_bigip_address  = "10.0.0.1"    # DC Active management IP
standby_bigip_address = "10.0.0.2"    # DC Standby management IP
bigip_username        = "admin"
bigip_password        = "CHANGE_ME"
bigip_port            = "443"

# ------------------------------------------------------------------------------
# Shared Settings (applied to BOTH devices)
# ------------------------------------------------------------------------------

dns_nameservers    = ["10.1.1.10", "10.1.1.11"]
dns_search_domains = ["example.com", "internal.example.com"]

ntp_servers = ["ntp1.example.com", "ntp2.example.com"]
timezone    = "Asia/Kolkata"

provisioning = {
  ltm = "nominal"
}

device_group_name = "dc-failover-group"

# users = [
#   {
#     name     = "devops-user"
#     password = "CHANGE_ME"
#     role     = "admin"
#     shell    = "tmsh"
#   }
# ]

# syslog_remote_servers = [
#   {
#     name = "syslog-primary"
#     host = "syslog.example.com"
#     port = 514
#   }
# ]

# snmp_agent = {
#   contact    = "NOC Team <noc@example.com>"
#   location   = "DC-Rack42"
#   allow_list = ["10.0.0.0/8"]
# }

